# Copy to .env and fill in your values:  cp .env.example .env
# .env is gitignored — never commit real credentials.

WIFI_SSID=YourNetwork
WIFI_PASSWORD=YourPassword
IMAGE_URL=http://your-server.com/image.png

# Seconds between display refreshes (deep-sleep interval).
UPDATE_INTERVAL=300

# Optional urgent sound alert: if set, each wake fetches this URL and plays the
# embedded chime when the body is exactly "true". Comment out to disable entirely.
# URGENT_URL=http://your-server.com/urgent.txt
# URGENT_VOLUME=70

# Optional: serial port for upload/monitor (auto-detected if omitted).
# UPLOAD_PORT=/dev/cu.usbmodem101
